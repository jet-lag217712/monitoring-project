# Build from the repository root: docker build -f services/snmp-collector/Dockerfile.core .
FROM golang:1.25-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58 AS build
WORKDIR /src
COPY services/ingestion-service ./services/ingestion-service
COPY services/snmp-collector ./services/snmp-collector
WORKDIR /src/services/snmp-collector
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/equate-core ./cmd/equate-core

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=build /out/equate-core /equate-core
USER nonroot:nonroot
ENTRYPOINT ["/equate-core"]
CMD ["-config", "/etc/equate/application.yaml"]
