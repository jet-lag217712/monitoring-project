# Managed by configure-vm.sh — passwordless sudo for appliance operators.
%equate-appliance ALL=(root) NOPASSWD: /usr/local/bin/equate view *
%equate-appliance ALL=(root) NOPASSWD: /usr/local/bin/equate configure *
%equate-appliance ALL=(root) NOPASSWD: /usr/local/bin/equate users *
%equate-appliance ALL=(root) NOPASSWD: /opt/equate/scripts/manage-users.sh *
