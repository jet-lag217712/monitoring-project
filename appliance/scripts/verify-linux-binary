#!/usr/bin/env bash
set -euo pipefail

binary=${1:?binary path is required}
arch=${2:?architecture is required}

[[ -f "${binary}" ]] || { echo "missing binary: ${binary}" >&2; exit 2; }
magic="$(dd if="${binary}" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')"
[[ "${magic}" == "7f454c46" ]] || { echo "${binary} is not an ELF binary" >&2; exit 1; }
machine="$(dd if="${binary}" bs=1 skip=18 count=2 2>/dev/null | od -An -tu2 | tr -d ' \n')"
case "${arch}" in
  amd64) expected=62 ;;
  arm64) expected=183 ;;
  *) echo "unsupported architecture: ${arch}" >&2; exit 2 ;;
esac
[[ "${machine}" == "${expected}" ]] || {
  echo "${binary} has ELF machine ${machine}, expected ${expected} for ${arch}" >&2
  exit 1
}
