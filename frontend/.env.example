# Backend API base URL (no trailing slash required)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Web Client ID (same value the API validates as aud)
VITE_GOOGLE_CLIENT_ID=

# When true, API failures fall back to mock demo data. Keep false in production builds.
VITE_DEMO_ENABLED=true

# Optional. Same value as equate CLI buildVersion (`equate version`).
# Appliance release builds inject this; local/dev falls back to git describe.
# VITE_APP_VERSION=1.4.0
