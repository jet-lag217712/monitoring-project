{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equate:ogsd:telemetry:v2:heartbeat-event",
  "title": "SNMP Collector v2 collector heartbeat event",
  "allOf": [
    {
      "$ref": "urn:equate:ogsd:telemetry:v2:event-envelope#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "event_type": {
          "const": "collector_heartbeat"
        },
        "payload": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "git_commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "build_time": {
              "anyOf": [
                {
                  "$ref": "urn:equate:ogsd:telemetry:v2:event-envelope#/$defs/timestamp"
                },
                {
                  "const": "unknown"
                }
              ]
            },
            "uptime_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "sqlite_queue_depth": {
              "type": "integer",
              "minimum": 0
            },
            "memory_usage_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "goroutine_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "hostname",
            "version",
            "git_commit",
            "build_time",
            "uptime_seconds",
            "sqlite_queue_depth",
            "memory_usage_bytes",
            "goroutine_count"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
