{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equate:ogsd:telemetry:v2:interface-event",
  "title": "SNMP Collector v2 interface telemetry event",
  "allOf": [
    {
      "$ref": "urn:equate:ogsd:telemetry:v2:event-envelope#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "event_type": {
          "const": "interface_telemetry"
        },
        "device_id": {
          "$ref": "urn:equate:ogsd:telemetry:v2:event-envelope#/$defs/identifier"
        },
        "payload": {
          "type": "object",
          "properties": {
            "interface": {
              "type": "object",
              "properties": {
                "if_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "alias": {
                  "type": "string",
                  "maxLength": 255
                },
                "type": {
                  "type": "string",
                  "maxLength": 128
                },
                "admin_status": {
                  "enum": ["up", "down", "testing", "unknown"]
                },
                "oper_status": {
                  "enum": ["up", "down", "testing", "unknown"]
                },
                "speed_bps": {
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              },
              "required": [
                "if_index",
                "name",
                "admin_status",
                "oper_status",
                "speed_bps"
              ],
              "additionalProperties": false
            },
            "counters": {
              "type": "object",
              "properties": {
                "in_octets": {
                  "type": "integer",
                  "minimum": 0
                },
                "out_octets": {
                  "type": "integer",
                  "minimum": 0
                },
                "in_errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "out_errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "in_discards": {
                  "type": "integer",
                  "minimum": 0
                },
                "out_discards": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "in_octets",
                "out_octets",
                "in_errors",
                "out_errors"
              ],
              "additionalProperties": false
            }
          },
          "required": ["interface", "counters"],
          "additionalProperties": false
        }
      },
      "required": ["device_id"]
    }
  ],
  "unevaluatedProperties": false
}
