# Development on-site collector environment (copy to .env — never commit secrets).

MQTT_BROKER=tls://CHANGE_ME.example.com:8883
MQTT_PASSWORD=CHANGE_ME
COLLECTOR_ADMIN_PORT=9090

# SNMP communities (set locally; never commit real values).
SNMP_COMMUNITY_DO_CORE=CHANGE_ME
SNMP_COMMUNITY_SITE_A_MDF=CHANGE_ME
SNMP_COMMUNITY_SITE_A_IDF1=CHANGE_ME
SNMP_COMMUNITY_SITE_A_IDF2=CHANGE_ME
SNMP_COMMUNITY_SITE_B_MDF=CHANGE_ME
SNMP_COMMUNITY_SITE_C_MDF=CHANGE_ME
SNMP_COMMUNITY_SITE_C_IDF1=CHANGE_ME

# Used by sync.sh from the Mac (optional defaults shown).
VXRAIL_SSH_HOST=192.168.0.10
VXRAIL_SSH_USER=gns3
VXRAIL_REMOTE_DIR=/home/gns3/ogsd-vxrail
