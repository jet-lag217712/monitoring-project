# Development cloud-plane environment (copy to .env and adjust).
# Collector runs separately on the OrbStack Ubuntu VM via development/vxrail/.

# --- Postgres ---
POSTGRES_USER=ogsd
POSTGRES_PASSWORD=ogsd
POSTGRES_DB=ogsd
POSTGRES_HOST_PORT=5432
ADMIN_DATABASE_URL=postgres://ogsd:ogsd@127.0.0.1:5432/ogsd?sslmode=disable

OGSD_INGESTION_USER=ogsd_ingestion
OGSD_INGESTION_PASSWORD=ingestion
OGSD_API_USER=ogsd_api
OGSD_API_PASSWORD=api

# --- Mosquitto (must be reachable from the GNS3 Ubuntu VM) ---
MQTT_HOST_PORT=8883
MQTT_COLLECTOR_PASSWORD=secret
MQTT_INGESTION_PASSWORD=ingestion
MQTT_SERVER_CN=localhost
MQTT_SERVER_DNS=mosquitto,localhost
# Set the Mac host IP visible from the OrbStack VM before first cert generation.
MQTT_SERVER_IP=

# --- Ports / frontend ---
INGESTION_ADMIN_PORT=9091
API_HOST_PORT=8000
API_ADMIN_PORT=9092
FRONTEND_HOST_PORT=80
VITE_API_BASE_URL=http://127.0.0.1
VITE_GOOGLE_CLIENT_ID=
VITE_DEMO_ENABLED=false
GOOGLE_CLIENT_ID=

# --- Smoke ---
SMOKE_SITE_ID=site-dev
SMOKE_DEVICE_ID=dev-smoke-device
