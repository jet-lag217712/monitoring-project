# End-to-end self-hosted stack (copy to .env and adjust).
# Used for quick client-site validation. Requires a real SNMP inventory.

# --- Postgres ---
POSTGRES_USER=ogsd
POSTGRES_PASSWORD=ogsd
POSTGRES_DB=ogsd
POSTGRES_HOST_PORT=5432
ADMIN_DATABASE_URL=postgres://ogsd:ogsd@127.0.0.1:5432/ogsd?sslmode=disable

OGSD_INGESTION_USER=ogsd_ingestion
OGSD_INGESTION_PASSWORD=ingestion
OGSD_API_USER=ogsd_api
OGSD_API_PASSWORD=api

# --- Mosquitto ---
MQTT_HOST_PORT=8883
MQTT_COLLECTOR_PASSWORD=secret
MQTT_INGESTION_PASSWORD=ingestion
MQTT_SERVER_CN=localhost
MQTT_SERVER_DNS=mosquitto,localhost
MQTT_SERVER_IP=

# --- Ports / frontend ---
INGESTION_ADMIN_PORT=9091
API_HOST_PORT=8000
API_ADMIN_PORT=9092
FRONTEND_HOST_PORT=80
COLLECTOR_ADMIN_PORT=9090
VITE_API_BASE_URL=http://127.0.0.1
VITE_GOOGLE_CLIENT_ID=66724909104-4nl9nul308sjpnh8tpr0cufsoo3b1887.apps.googleusercontent.com
VITE_DEMO_ENABLED=false
GOOGLE_CLIENT_ID=66724909104-4nl9nul308sjpnh8tpr0cufsoo3b1887.apps.googleusercontent.com

# --- Smoke / acceptance ---
# Site/device IDs used by synthetic MQTT smoke and optional real-device acceptance.
SMOKE_SITE_ID=site-e2e
SMOKE_DEVICE_ID=e2e-smoke-device
ACCEPTANCE_SITE_ID=site-001
ACCEPTANCE_DEVICE_ID=do-core
