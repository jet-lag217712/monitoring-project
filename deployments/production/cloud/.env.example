# Production cloud plane environment (copy to .env — never commit secrets).

POSTGRES_USER=ogsd
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ogsd
POSTGRES_HOST_PORT=5432
ADMIN_DATABASE_URL=postgres://ogsd:CHANGE_ME@127.0.0.1:5432/ogsd?sslmode=disable

OGSD_INGESTION_USER=ogsd_ingestion
OGSD_INGESTION_PASSWORD=CHANGE_ME
OGSD_API_USER=ogsd_api
OGSD_API_PASSWORD=CHANGE_ME

MQTT_HOST_PORT=8883
MQTT_COLLECTOR_PASSWORD=CHANGE_ME
MQTT_INGESTION_PASSWORD=CHANGE_ME

INGESTION_ADMIN_PORT=9091
API_HOST_PORT=8000
API_ADMIN_PORT=9092
FRONTEND_HOST_PORT=80

# Production UI URL used at frontend build time
VITE_API_BASE_URL=https://CHANGE_ME.example.com
VITE_GOOGLE_CLIENT_ID=CHANGE_ME
VITE_DEMO_ENABLED=false
GOOGLE_CLIENT_ID=CHANGE_ME

# Optional: when using Azure Flexible Server instead of the compose postgres service,
# point DATABASE_URL overrides in compose / secrets and remove the postgres service.
